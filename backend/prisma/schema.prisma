// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteScan {
  id String @id @default(uuid())
  url String
  registrarCountry String?
  registrarName String?
  sslIssuer String?
  hasInstagram Boolean?
  instagramFollowers Int?
  socialProfileCount Int?
  isFlaggedUnsafe Boolean?
  threatType String?
  hasTrustpilot Boolean?
  trustScore Int?
  scanStatus String?
  domainAge Int?
  trustRating Float?
  previewImage String?
  createdAt DateTime @default(now())
  listingScans ListingScan[]
}

model ListingScan {
  id String @id @default(uuid())
  listingUrl String
  siteScanId String?
  siteScan SiteScan? @relation(fields: [siteScanId], references: [id])
  currentPrice Float?
  priceHistoryLow Float?
  priceHistoryHigh Float?
  reviewCount Int?
  averageRating Float?
  reviewDateClustering Boolean?
  genericReviewScore Float?
  hasUrgencyLanguage Boolean?
  hasReturnPolicy Boolean?
  trustScore Int?
  scanStatus String?
  productImage String?
  createdAt DateTime @default(now())
}